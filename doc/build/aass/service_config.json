{
  "web": {
    "http_port": 9091
  },
  "service_endpoint": {
    "app_gateway": "{appgateway_host}:{appgateway_port}"
  },
  "default_configuration": {
    "influx_measurement": "process",
    "monitor_duration": "30s",
    "work_node": {
      "task_over_task_interval_seconds": 60,
      "heart_beat_task_interval_seconds": 300,
      "dead_check_task_interval_seconds": 300,
      "max_dead_minutes": 10
    },
    "enterprise_project_id": "{enterprise_project}",
    "scaling_group":{
      "instance_maximum_limit":200,
      "bandwidth_maximum_limit":300,
      "supported_volume_types":"SATA;SAS;SSD;GPSSD"
    },
    "clean_up_day_before":14,
    "clean_up_period_hour":1,
    "health_check_interval":30
  }
}
